# PRODUCTION API KEYS AND CONFIGURATION
# Register free developer credentials on Freesound.org and Jamendo.com

# Freesound API tokens (supports rotation)
FREESOUND_KEY_1=your_freesound_key_1_here
FREESOUND_KEY_2=your_freesound_key_2_here

# Jamendo Client ID
JAMENDO_KEY=your_jamendo_client_id_here

# ElevenLabs API Key (Optional backend default key)
ELEVENLABS_KEY=your_elevenlabs_api_key_here

# Rate Limit Config
DAILY_LIMIT_PER_IP=20

# Google Gemini API Key (Required for AI creative orchestration)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Qualcomm AI Hub API Token (Optional, for Hexagon NPU compilation and profiling)
# Configure via `qai-hub configure` or paste token here
QAI_HUB_API_TOKEN=your_qualcomm_ai_hub_token_here

# Optional License Verification Server URL
LICENSE_VERIFICATION_URL=
